# ===== Браузер и сеть =====
# headless: 1 - без окна (сервер), 0 - с окном (отладка)
EFRSB_HEADLESS=1
# канал браузера: msedge | chrome | chromium
EFRSB_BROWSER=msedge
# Необязательный сетевой прокси для разрешённых подключений:
# EFRSB_PROXY=http://user:pass@host:port
# EFRSB_PROXY=socks5://127.0.0.1:1080
EFRSB_PROXY=
EFRSB_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
EFRSB_LOCALE=ru-RU
EFRSB_TIMEOUT=90000
EFRSB_NAV_TIMEOUT=60000
# Новый интерфейс: https://fedresurs.ru/sfactmessages/
# Старая версия: https://old.bankrot.fedresurs.ru/MessageWindow.aspx
EFRSB_SEARCH_URL=https://fedresurs.ru/sfactmessages/

# ===== Поиск =====
EFRSB_MAX_PAGES=200
EFRSB_DAYS_BACK=30

# ===== Фото =====
# движки поиска изображений через запятую: yandex,bing,duckduckgo,avito
EFRSB_PHOTO_ENGINES=yandex,bing,duckduckgo
EFRSB_PHOTOS_PER_LOT=24
EFRSB_PHOTO_MIN_WIDTH=120
EFRSB_PHOTO_MIN_HEIGHT=80
EFRSB_DOWNLOAD_CONCURRENCY=4
# referer при скачивании: engine | site | none
EFRSB_REFERER_POLICY=engine

# ===== Оффлайн-режим =====
# Offline-режим используется только явной командой CLI:
# python scripts/run_scraper.py --offline data/offline
# Каталог: data/offline

# ===== Сервер =====
EFRSB_HOST=127.0.0.1
EFRSB_PORT=8000
EFRSB_VERBOSE=1

# Пароль администратора (расширенные функции и журнал)
ADMIN_PASSWORD=

# ===== Анализ лота по запросу (DeepSeek, только сервер) =====
# Оставьте пустым до подключения. Ключ не размещается в браузере или GitHub.
DEEPSEEK_API_KEY=
# Для анализа выбранных фото нужна модель с поддержкой vision.
DEEPSEEK_ANALYSIS_MODEL=deepseek-flash
AI_ANALYSIS_MAX_PHOTOS=6
AI_ANALYSIS_MAX_QUERIES=2
AI_ANALYSIS_MAX_PAGES=6
AI_ANALYSIS_DAILY_LIMIT=20
AI_ANALYSIS_CACHE_MINUTES=30
AI_ANALYSIS_MAX_SECONDS=240
AI_ANALYSIS_MAX_TOKENS=4000
AI_ANALYSIS_REQUEST_TIMEOUT_SECONDS=120

# ===== Торги-россии.рф =====
TORGI_MAX_PAGES=20
TORGI_FETCH_DETAILS=1
# Ежедневный автопарсинг (поиск новых лотов)
TORGI_AUTO_SCRAPE=1
TORGI_AUTO_SCRAPE_DELAY_MIN=5
TORGI_SCRAPE_INTERVAL_HOURS=24
TORGI_SCRAPE_PAGES=30
# Обновление статусов/цен по detail-страницам у активных лотов,
# заканчивающихся в ближайшие N дней (публичные предложения — всегда)
TORGI_STATUS_REFRESH_DAYS=7

# ===== Email (SMTP для отправки) — Yandex =====
# Нужен "пароль приложения" из Яндекс ID; включите IMAP в Яндекс.Почте.
EMAIL_SMTP_HOST=smtp.yandex.ru
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@yandex.ru
EMAIL_SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@yandex.ru
EMAIL_FROM_NAME=Автомобильные торги
EMAIL_USE_TLS=1

# ===== Email (IMAP для приёма ответов) — Yandex =====
EMAIL_IMAP_HOST=imap.yandex.ru
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=your_email@yandex.ru
EMAIL_IMAP_PASSWORD=your_app_password

# ===== Email (вторая почта) для повторной отправки не доставленных писем =====
EMAIL2_ENABLED=0
EMAIL2_SMTP_HOST=smtp.yandex.ru
EMAIL2_SMTP_PORT=465
EMAIL2_SMTP_USER=your_email2@yandex.ru
EMAIL2_SMTP_PASSWORD=your_app_password
EMAIL2_FROM=your_email2@yandex.ru
EMAIL2_FROM_NAME=Автомобильные торги
EMAIL2_USE_TLS=1
EMAIL2_IMAP_HOST=imap.yandex.ru
EMAIL2_IMAP_PORT=993
EMAIL2_IMAP_USER=your_email2@yandex.ru
EMAIL2_IMAP_PASSWORD=your_app_password

# ===== Шаблон письма =====
EMAIL_SUBJECT=Запрос доп. информации по имуществу реализуемое на торгах
EMAIL_SIGNATURE=

# ===== Авто-рассылка запросов управляющим =====
# 1 - отправлять автоматически при старте и далее по интервалу (фоновый цикл)
EMAIL_AUTO_SEND=0
# через сколько минут после старта приложения отправить первую порцию
EMAIL_AUTO_SEND_DELAY_MIN=2
# интервал отправки, в минутах
EMAIL_SEND_INTERVAL_MIN=60
# сколько лотов за один цикл (пакет)
EMAIL_BATCH_SIZE=20
# жёсткий дневной лимит отправок (всего за сутки)
EMAIL_SEND_DAILY_LIMIT=80
# пауза между письмами, сек (защита от спам-фильтров)
EMAIL_SEND_DELAY_SEC=20
# прогрев ящика: лимит/день = start + step * (дней с первого запуска), не выше EMAIL_SEND_DAILY_LIMIT
EMAIL_WARMUP_START=20
EMAIL_WARMUP_STEP=10
# 1 - автоматически проверять входящие (IMAP) и сохранять ответы с фото
EMAIL_AUTO_CHECK=1
# интервал проверки ответов, в минутах
EMAIL_CHECK_INTERVAL_MIN=15
# за сколько последних дней просматривать входящие
EMAIL_CHECK_DAYS=30
# через сколько дней отправлять напоминание, если ответа нет
EMAIL_FOLLOW_UP_DAYS=7


